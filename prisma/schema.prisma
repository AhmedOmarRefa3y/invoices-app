// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Customer {
  id              String            @id @default(uuid())
  name            String
  phoneNumber     String            @default("")
  location        String            @default("")
  CustomerCredit  Int               @default(0)
  invoices        Invoice[]
  Payment         Payment[]
  ReturnedInvoice ReturnedInvoice[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @default(now()) @updatedAt
}

model Product {
  id              String            @id @default(uuid())
  name            String
  price           Int
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @default(now()) @updatedAt
  LineItem        LineItem[]
  ProductionEvent ProductionEvent[]
  Inventory       Inventory?
  Parts           Part[]
  catgory         Catgories?        @relation(fields: [catgoryId], references: [id])
  catgoryId       String?
  unit            Units?            @relation(fields: [unitId], references: [id])
  unitId          String?           @default("2b7065c4-d649-4817-aac1-8b09d4bec3a1")
}

model Part {
  id        String   @id @default(uuid())
  name      String
  quantity  Int // Quantity of this component in the product
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Invoice {
  id         String     @id @default(uuid())
  number     Int        @default(autoincrement())
  date       DateTime   @default(now())
  amount     Int
  lineItems  LineItem[]
  customerId String
  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  payment    Payment?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @default(now()) @updatedAt
}

model ReturnedInvoice {
  id         String     @id @default(uuid())
  number     Int        @default(autoincrement())
  date       DateTime   @default(now())
  amount     Int
  lineItems  LineItem[]
  customerId String
  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @default(now()) @updatedAt
}

model LineItem {
  id                String           @id @default(uuid())
  quantity          Int
  product           Product          @relation(fields: [productId], references: [id])
  productId         String
  price             Int
  invoice           Invoice?         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId         String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @default(now()) @updatedAt
  ReturnedInvoice   ReturnedInvoice? @relation(fields: [returnedInvoiceId], references: [id], onDelete: Cascade)
  returnedInvoiceId String?
  amount            Int
}

model Payment {
  id         String   @id @default(uuid())
  number     Int      @default(autoincrement())
  date       DateTime @default(now())
  amount     Int
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  method     String
  notes      String   @default("")
  invoice    Invoice? @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId  String?  @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt
}

model Inventory {
  id               String            @id @default(uuid())
  quantity         Int
  productId        String            @unique
  product          Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @default(now()) @updatedAt
  ProductionEvents ProductionEvent[]
}

model ProductionEvent {
  id          String     @id @default(uuid())
  productId   String
  product     Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity    Int
  producedAt  DateTime   @default(now())
  // Add more fields as needed to describe the production event
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @default(now()) @updatedAt
  Inventory   Inventory? @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  inventoryId String?
}

model Catgories {
  id       String    @id @default(uuid())
  name     String
  products Product[]
}

model Units {
  id       String    @id @default(uuid())
  name     String
  products Product[]
}
