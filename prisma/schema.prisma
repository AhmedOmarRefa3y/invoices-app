generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model organization {
  id                    String                  @id @default(uuid())
  name                  String
  ownerId               String
  owner                 User                    @relation(fields: [ownerId], references: [id])
  managers              User[]                  @relation("OrganizationManagers")
  lastInvoiceNumber     Int                     @default(0) // Tracks last used number
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @default(now()) @updatedAt
  products              Product[]
  Parts                 Part[]
  LineItem              LineItem[]
  Orders                OrderItem[]
  invoices              Invoice[]
  Payment               Payment[]
  ReturnedInvoice       ReturnedInvoice[]
  ProductionPlan        ProductionPlan[]
  ProductionEvent       ProductionEvent[]
  Catgories             Catgories[]
  Units                 Units[]
  ProductionPLanProduct ProductionPLanProduct[]
  Initialquantities     Initialquantities[]
  Customer              Customer[]
  PurchaseInvoice       PurchaseInvoice[]
  PaymentToSupplier     PaymentToSupplier[]
  LedgerAccount         LedgerAccount[]
  JournalEntry          JournalEntry[]
  JournalEntryLine      JournalEntryLine[]
}

model User {
  id                   String         @id @default(cuid())
  name                 String?
  password             String?
  email                String         @unique
  emailVerified        DateTime?
  image                String?
  accounts             Account[]
  sessions             Session[]
  role                 String         @default("user")
  Managedorganizations organization[] @relation("OrganizationManagers")
  Ownedorganizations   organization[]
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@map("users")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_tokens")
}

model Customer {
  id                String              @id @default(uuid())
  name              String
  phoneNumber       String              @default("")
  location          String              @default("")
  CustomerCredit    Float               @default(0)
  invoices          Invoice[]
  Payment           Payment[]
  ReturnedInvoice   ReturnedInvoice[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @default(now()) @updatedAt
  organization      organization        @relation(fields: [organizationId], references: [id])
  organizationId    String
  PurchaseInvoice   PurchaseInvoice[]
  IsASupplier       Boolean             @default(false)
  PaymentToSupplier PaymentToSupplier[]
  LedgerAccountId   String?             @unique // link to chart of accounts
  LedgerAccount     LedgerAccount?      @relation(fields: [LedgerAccountId], references: [id])
}

enum Roles {
  ADMIN
  USER
}

model Product {
  id                    String                  @id @default(uuid())
  code                  Int                     @default(autoincrement())
  name                  String
  price                 Float
  category              Catgories               @relation(fields: [catgoryId], references: [id])
  catgoryId             String
  unit                  Units                   @relation(fields: [unitId], references: [id])
  unitId                String
  LineItem              LineItem[]
  Orders                OrderItem[]
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @default(now()) @updatedAt
  Part                  Part[]
  isAcomopsition        Boolean                 @default(false)
  ProductionPLanProduct ProductionPLanProduct[]
  organization          organization            @relation(fields: [organizationId], references: [id])
  organizationId        String
  initialquantity       Float                   @default(0)
}

model Part {
  id             String       @id @default(uuid())
  name           String
  quantity       Float
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId      String
  partProductId  String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt
  organization   organization @relation(fields: [organizationId], references: [id])
  organizationId String
}

model OrderItem {
  id                String           @id @default(uuid())
  quantity          Float
  amount            Float
  price             Float
  Product           Product          @relation(fields: [productId], references: [id])
  productId         String
  Invoice           Invoice?         @relation(fields: [invoiceId], references: [id])
  invoiceId         String?
  ReturnedInvoice   ReturnedInvoice? @relation(fields: [returnedInvoiceId], references: [id])
  returnedInvoiceId String?
  OrderNumber       Int              @default(0)
  organization      organization     @relation(fields: [organizationId], references: [id])
  organizationId    String
}

model LineItem {
  id                  String             @id @default(uuid())
  amount              Float?
  quantity            Float
  price               Float?
  ItemNumber          Int                @default(0)
  product             Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId           String
  invoice             Invoice?           @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId           String?
  ReturnedInvoice     ReturnedInvoice?   @relation(fields: [returnedInvoiceId], references: [id], onDelete: Cascade)
  returnedInvoiceId   String?
  ProductionEvent     ProductionEvent?   @relation(fields: [productionEventId], references: [id], onDelete: Cascade)
  productionEventId   String?
  isProduction        Boolean            @default(false)
  isReduction         Boolean            @default(false)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @default(now()) @updatedAt
  ProductionPlan      ProductionPlan?    @relation(fields: [productionPlanId], references: [id], onDelete: Cascade)
  productionPlanId    String?
  Initialquantities   Initialquantities? @relation(fields: [initialquantitiesId], references: [id], onDelete: Cascade)
  initialquantitiesId String?
  organization        organization       @relation(fields: [organizationId], references: [id])
  organizationId      String
  PurchaseInvoice     PurchaseInvoice?   @relation(fields: [purchaseInvoiceId], references: [id])
  purchaseInvoiceId   String?
}

model Initialquantities {
  id             String       @id @default(uuid())
  date           DateTime     @default(now())
  year           Int          @unique
  products       LineItem[]
  quantity       Float        @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt
  organization   organization @relation(fields: [organizationId], references: [id])
  organizationId String
}

model Invoice {
  id             String       @id @default(uuid())
  number         Int          @default(autoincrement())
  date           DateTime     @default(now())
  amount         Float
  orders         OrderItem[]
  lineItems      LineItem[]
  customerId     String
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  payment        Payment?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt
  organization   organization @relation(fields: [organizationId], references: [id])
  organizationId String
}

model PurchaseInvoice {
  id                String             @id @default(uuid())
  number            Int                @default(autoincrement())
  date              DateTime           @default(now())
  amount            Float
  lineItems         LineItem[]
  SupplierId        String
  Supplier          Customer           @relation(fields: [SupplierId], references: [id], onDelete: Cascade)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @default(now()) @updatedAt
  organization      organization       @relation(fields: [organizationId], references: [id])
  organizationId    String
  PaymentToSupplier PaymentToSupplier?
}

model ReturnedInvoice {
  id             String       @id @default(uuid())
  number         Int          @default(autoincrement())
  date           DateTime     @default(now())
  amount         Float
  orders         OrderItem[]
  lineItems      LineItem[]
  customerId     String
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt
  organization   organization @relation(fields: [organizationId], references: [id])
  organizationId String
}

model ProductionPLanProduct {
  id               String          @id @default(uuid())
  productId        String
  quantity         Float
  Product          Product         @relation(fields: [productId], references: [id])
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @default(now()) @updatedAt
  ProductionPlan   ProductionPlan? @relation(fields: [productionPlanId], references: [id], onDelete: Cascade)
  productionPlanId String?
  organization     organization    @relation(fields: [organizationId], references: [id])
  organizationId   String
}

model ProductionPlan {
  id               String                  @id @default(uuid())
  number           Int                     @unique @default(autoincrement())
  lineItems        LineItem[]
  ProductionEvents ProductionEvent[]
  Products         ProductionPLanProduct[]
  producedAt       DateTime                @default(now())
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @default(now()) @updatedAt
  organization     organization            @relation(fields: [organizationId], references: [id])
  organizationId   String
}

model ProductionEvent {
  id               String          @id @default(uuid())
  number           Int             @unique @default(autoincrement())
  lineItems        LineItem[]
  producedAt       DateTime        @default(now())
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @default(now()) @updatedAt
  ProductionPlan   ProductionPlan? @relation(fields: [productionPlanId], references: [id], onDelete: Cascade)
  productionPlanId String?
  organization     organization    @relation(fields: [organizationId], references: [id])
  organizationId   String
}

model Payment {
  id             String       @id @default(uuid())
  number         Int          @default(autoincrement())
  date           DateTime     @default(now())
  amount         Float
  customerId     String
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  method         String
  notes          String       @default("")
  invoice        Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId      String?      @unique
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt
  organization   organization @relation(fields: [organizationId], references: [id])
  organizationId String
}

model PaymentToSupplier {
  id                String           @id @default(uuid())
  number            Int              @default(autoincrement())
  date              DateTime         @default(now())
  amount            Float
  customerId        String
  customer          Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  method            String
  notes             String           @default("")
  Purchaseinvoice   PurchaseInvoice? @relation(fields: [PurchaseinvoiceId], references: [id], onDelete: Cascade)
  PurchaseinvoiceId String?          @unique
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @default(now()) @updatedAt
  organization      organization     @relation(fields: [organizationId], references: [id])
  organizationId    String
}

model Catgories {
  id             String       @id @default(uuid())
  name           String
  products       Product[]
  organization   organization @relation(fields: [organizationId], references: [id])
  organizationId String
}

model Units {
  id             String       @id @default(uuid())
  name           String
  products       Product[]
  organization   organization @relation(fields: [organizationId], references: [id])
  organizationId String
}

model LedgerAccount {
  id               String             @id @default(uuid())
  organization     organization       @relation(fields: [organizationId], references: [id])
  organizationId   String
  code             String             @unique // e.g. 1000, 1000-01
  name             String
  type             LedgerAccountType
  normalSide       BalanceSide // which side increases this account (Debit/Credit)
  parentId         String?
  parent           LedgerAccount?     @relation("AccountChildren", fields: [parentId], references: [id])
  children         LedgerAccount[]    @relation("AccountChildren")
  isLeaf           Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  JournalEntryLine JournalEntryLine[]
  customer         Customer?
  customerId       String?

  @@index([code])
}

model JournalEntry {
  id             String             @id @default(uuid())
  organization   organization       @relation(fields: [organizationId], references: [id])
  organizationId String
  number         Int                @unique
  date           DateTime
  description    String?
  posted         Boolean            @default(false) // false = draft
  lines          JournalEntryLine[]
  createdBy      String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([date])
}

model JournalEntryLine {
  id             String        @id @default(uuid())
  organization   organization  @relation(fields: [organizationId], references: [id])
  organizationId String
  journalId      String
  journal        JournalEntry  @relation(fields: [journalId], references: [id], onDelete: Cascade)
  accountId      String
  account        LedgerAccount @relation(fields: [accountId], references: [id])
  description    String?
  debit          Decimal       @default(0)
  credit         Decimal       @default(0)
  currency       String        @default("USD")
  exchangeRate   Decimal?
  reference      String?
  createdAt      DateTime      @default(now())

  @@index([accountId])
}

enum LedgerAccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum BalanceSide {
  DEBIT
  CREDIT
}
