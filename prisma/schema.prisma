// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Customer {
  id              String            @id @default(uuid())
  name            String
  phoneNumber     String            @default("")
  location        String            @default("")
  CustomerCredit  Float             @default(0)
  invoices        Invoice[]
  Payment         Payment[]
  ReturnedInvoice ReturnedInvoice[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @default(now()) @updatedAt
}

model Product {
  id              String           @id @default(uuid())
  name            String
  price           Float
  category        Catgories?       @relation(fields: [categoryId], references: [id])
  categoryId      String?
  unit            Units?           @relation(fields: [unitId], references: [id])
  unitId          String?
  LineItem        LineItem[]
  Orders          OrderItem[]
  InventoryRecord InventoryRecord?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @default(now()) @updatedAt
  Part            Part[]
}

model Part {
  id               String          @id @default(uuid())
  name             String
  quantity         Float // Quantity of this component in the product
  product          Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId        String
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @default(now()) @updatedAt
  ProductPackage   ProductPackage? @relation(fields: [productPackageId], references: [id])
  productPackageId String?
}

model ProductPackage {
  id        String      @id @default(uuid())
  name      String
  price     Float
  unit      Units?      @relation(fields: [unitId], references: [id])
  unitId    String?
  Parts     Part[]
  orders    OrderItem[]
  createdAt DateTime    @default(now())
  updatedAt DateTime
}

model OrderItem {
  id                String           @id @default(uuid())
  quantity          Float
  amount            Float
  price             Float
  ProductPackage    ProductPackage?  @relation(fields: [productPackageId], references: [id])
  productPackageId  String?
  Product           Product?         @relation(fields: [productId], references: [id])
  productId         String?
  Invoice           Invoice?         @relation(fields: [invoiceId], references: [id])
  invoiceId         String?
  ReturnedInvoice   ReturnedInvoice? @relation(fields: [returnedInvoiceId], references: [id])
  returnedInvoiceId String?
}

model LineItem {
  id                String           @id @default(uuid())
  quantity          Float
  ItemNumber        Int              @default(0)
  product           Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId         String
  invoice           Invoice?         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId         String?
  ReturnedInvoice   ReturnedInvoice? @relation(fields: [returnedInvoiceId], references: [id], onDelete: Cascade)
  returnedInvoiceId String?
  ProductionEvent   ProductionEvent? @relation(fields: [productionEventId], references: [id])
  productionEventId String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @default(now()) @updatedAt
}

model Initialquantity {
  id                String          @id @default(uuid())
  year              Int
  quantity          Float           @default(0)
  InventoryRecord   InventoryRecord @relation(fields: [InventoryRecordId], references: [id], onDelete: Cascade)
  InventoryRecordId String
}

model InventoryRecord {
  id               String            @id @default(uuid())
  product          Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId        String            @unique
  year             Int               @default(2024)
  openingQuantity  Float             @default(0)
  IssuedQuantity   Float             @default(0)
  ReceivedQuantity Float             @default(0)
  Initialquantity  Initialquantity[]
}

model Invoice {
  id         String      @id @default(uuid())
  number     Int         @default(autoincrement())
  date       DateTime    @default(now())
  amount     Float
  orders     OrderItem[]
  lineItems  LineItem[]
  customerId String
  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  payment    Payment?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @default(now()) @updatedAt
}

model ReturnedInvoice {
  id         String      @id @default(uuid())
  number     Int         @default(autoincrement())
  date       DateTime    @default(now())
  amount     Float
  orders     OrderItem[]
  lineItems  LineItem[]
  customerId String
  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @default(now()) @updatedAt
}

model ProductionEvent {
  id         String     @id @default(uuid())
  lineItems  LineItem[]
  producedAt DateTime   @default(now())
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @default(now()) @updatedAt
}

model Payment {
  id         String   @id @default(uuid())
  number     Int      @default(autoincrement())
  date       DateTime @default(now())
  amount     Float
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  method     String
  notes      String   @default("")
  invoice    Invoice? @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId  String?  @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt
}

model Catgories {
  id       String    @id @default(uuid())
  name     String
  products Product[]
}

model Units {
  id             String           @id @default(uuid())
  name           String
  products       Product[]
  ProductPackage ProductPackage[]
}
