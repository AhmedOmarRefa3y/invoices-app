generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Customer {
  id              String            @id @default(uuid())
  name            String
  phoneNumber     String            @default("")
  location        String            @default("")
  CustomerCredit  Float             @default(0)
  invoices        Invoice[]
  Payment         Payment[]
  ReturnedInvoice ReturnedInvoice[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @default(now()) @updatedAt
}

model user {
  id        String   @id @default(uuid())
  userName  String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Product {
  id                    String                  @id @default(uuid())
  code                  Int                     @default(autoincrement())
  name                  String
  price                 Float
  category              Catgories?              @relation(fields: [catgoryId], references: [id])
  catgoryId             String?
  unit                  Units?                  @relation(fields: [unitId], references: [id])
  unitId                String?
  LineItem              LineItem[]
  Orders                OrderItem[]
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @default(now()) @updatedAt
  Part                  Part[]
  ProductionEvent       ProductionEvent[]
  isAcomopsition        Boolean                 @default(false)
  ProductionPLanProduct ProductionPLanProduct[]
}

model Part {
  id               String          @id @default(uuid())
  name             String
  quantity         Float
  product          Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId        String
  partProductId    String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @default(now()) @updatedAt
  ProductPackage   ProductPackage? @relation(fields: [productPackageId], references: [id])
  productPackageId String?
}

model ProductPackage {
  id        String      @id @default(uuid())
  name      String
  price     Float
  unit      Units?      @relation(fields: [unitId], references: [id])
  unitId    String?
  Parts     Part[]
  orders    OrderItem[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @default(now())
}

model OrderItem {
  id                String           @id @default(uuid())
  quantity          Float
  amount            Float
  price             Float
  ProductPackage    ProductPackage?  @relation(fields: [productPackageId], references: [id])
  productPackageId  String?
  Product           Product?         @relation(fields: [productId], references: [id])
  productId         String?
  Invoice           Invoice?         @relation(fields: [invoiceId], references: [id])
  invoiceId         String?
  ReturnedInvoice   ReturnedInvoice? @relation(fields: [returnedInvoiceId], references: [id])
  returnedInvoiceId String?
  OrderNumber       Int              @default(0)
}

model LineItem {
  id                  String             @id @default(uuid())
  amount              Float?
  quantity            Float
  price               Float?
  ItemNumber          Int                @default(0)
  product             Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId           String
  invoice             Invoice?           @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId           String?
  ReturnedInvoice     ReturnedInvoice?   @relation(fields: [returnedInvoiceId], references: [id], onDelete: Cascade)
  returnedInvoiceId   String?
  ProductionEvent     ProductionEvent?   @relation(fields: [productionEventId], references: [id])
  productionEventId   String?
  isProduction        Boolean            @default(false)
  isReduction         Boolean            @default(false)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @default(now()) @updatedAt
  ProductionPlan      ProductionPlan?    @relation(fields: [productionPlanId], references: [id])
  productionPlanId    String?
  Initialquantities   Initialquantities? @relation(fields: [initialquantitiesId], references: [id])
  initialquantitiesId String?
}

model Initialquantities {
  id       String     @id @default(uuid())
  year     Years      @unique
  products LineItem[]
  quantity Float      @default(0)
}

enum Years {
  Year2022
  Year2023
  Year2024
  Year2025
  Year2026
  Year2027
  Year2028
  Year2029
  Year2030
}

model Invoice {
  id         String      @id @default(uuid())
  number     Int         @default(autoincrement())
  date       DateTime    @default(now())
  amount     Float
  orders     OrderItem[]
  lineItems  LineItem[]
  customerId String
  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  payment    Payment?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @default(now()) @updatedAt
}

model ReturnedInvoice {
  id         String      @id @default(uuid())
  number     Int         @default(autoincrement())
  date       DateTime    @default(now())
  amount     Float
  orders     OrderItem[]
  lineItems  LineItem[]
  customerId String
  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @default(now()) @updatedAt
}

model ProductionPLanProduct {
  id               String          @id @default(uuid())
  productId        String
  quantity         Float
  Product          Product         @relation(fields: [productId], references: [id])
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @default(now()) @updatedAt
  ProductionPlan   ProductionPlan? @relation(fields: [productionPlanId], references: [id])
  productionPlanId String?
}

model ProductionPlan {
  id               String                  @id @default(uuid())
  number           Int                     @unique @default(autoincrement())
  lineItems        LineItem[]
  ProductionEvents ProductionEvent[]
  Products         ProductionPLanProduct[]
  producedAt       DateTime                @default(now())
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @default(now()) @updatedAt
}

model ProductionEvent {
  id               String          @id @default(uuid())
  number           Int             @unique @default(autoincrement())
  lineItems        LineItem[]
  product          Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId        String?
  quantity         Float?
  producedAt       DateTime        @default(now())
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @default(now()) @updatedAt
  ProductionPlan   ProductionPlan? @relation(fields: [productionPlanId], references: [id])
  productionPlanId String?
}

model Payment {
  id         String   @id @default(uuid())
  number     Int      @default(autoincrement())
  date       DateTime @default(now())
  amount     Float
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  method     String
  notes      String   @default("")
  invoice    Invoice? @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId  String?  @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt
}

model Catgories {
  id       String    @id @default(uuid())
  name     String
  products Product[]
}

model Units {
  id             String           @id @default(uuid())
  name           String
  newname        unit?
  products       Product[]
  ProductPackage ProductPackage[]
}

enum unit {
  piece
  kit
  klg
}
