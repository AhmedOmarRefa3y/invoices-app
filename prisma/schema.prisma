// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Customer {
  id              String            @id @default(uuid())
  name            String
  phoneNumber     String            @default("")
  location        String            @default("")
  CustomerCredit  Float             @default(0)
  invoices        Invoice[]
  Payment         Payment[]
  ReturnedInvoice ReturnedInvoice[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @default(now()) @updatedAt
}

model Product {
  id                String            @id @default(uuid())
  name              String
  price             Float
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @default(now()) @updatedAt
  LineItem          LineItem[]
  ProductionEvent   ProductionEvent[]
  Parts             Part[]
  catgory           Catgories?        @relation(fields: [catgoryId], references: [id])
  catgoryId         String?
  unit              Units?            @relation(fields: [unitId], references: [id])
  unitId            String?
  InventoryRecord   InventoryRecord[]
  Invoice           Invoice?          @relation(fields: [invoiceId], references: [id])
  invoiceId         String?
  ReturnedInvoice   ReturnedInvoice?  @relation(fields: [returnedInvoiceId], references: [id])
  returnedInvoiceId String?
  Initialquantity   Initialquantity[]
}

model Initialquantity {
  id        String  @id @default(uuid())
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  year      Int
  quantity  Float   @default(0)
}

model InventoryRecord {
  id               String  @id @default(uuid())
  product          Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId        String
  year             Int     @default(2024)
  openingQuantity  Float   @default(0)
  IssuedQuantity   Float   @default(0)
  ReceivedQuantity Float   @default(0)
}

model Part {
  id        String   @id @default(uuid())
  name      String
  quantity  Float // Quantity of this component in the product
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Invoice {
  id         String     @id @default(uuid())
  number     Int        @default(autoincrement())
  date       DateTime   @default(now())
  amount     Float
  products   Product[]
  lineItems  LineItem[]
  customerId String
  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  payment    Payment?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @default(now()) @updatedAt
}

model ReturnedInvoice {
  id         String     @id @default(uuid())
  number     Int        @default(autoincrement())
  date       DateTime   @default(now())
  amount     Float
  products   Product[]
  lineItems  LineItem[]
  customerId String
  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @default(now()) @updatedAt
}

model LineItem {
  id                String           @id @default(uuid())
  quantity          Float
  product           Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId         String
  price             Float
  invoice           Invoice?         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId         String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @default(now()) @updatedAt
  ReturnedInvoice   ReturnedInvoice? @relation(fields: [returnedInvoiceId], references: [id], onDelete: Cascade)
  returnedInvoiceId String?
  amount            Float
  ItemNumber        Int              @default(0)
}

model Payment {
  id         String   @id @default(uuid())
  number     Int      @default(autoincrement())
  date       DateTime @default(now())
  amount     Float
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  method     String
  notes      String   @default("")
  invoice    Invoice? @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId  String?  @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt
}

model ProductionEvent {
  id         String   @id @default(uuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity   Int
  producedAt DateTime @default(now())
  // Add more fields as needed to describe the production event
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt
}

model Catgories {
  id       String    @id @default(uuid())
  name     String
  products Product[]
}

model Units {
  id       String    @id @default(uuid())
  name     String
  products Product[]
}
